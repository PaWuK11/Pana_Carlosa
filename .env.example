# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env

# Local preview server port (optional)
PORT=4321

# Where the browser sends booking requests during local dev.
# server.js serves this via /config.js so script.js picks it up automatically.
BOOKING_ENDPOINT=/booking

# Telegram — local dev only. On production these live in Cloudflare Worker secrets
# (wrangler secret put BOT_TOKEN / CHAT_ID), never in the static files.
BOT_TOKEN=
# Numeric id from @userinfobot (DM), or group id like -1001234567890 (bot must be in the group).
CHAT_ID=
