# Copy to .env and fill in. Never commit .env — it is gitignored.
#
#   cp .env.example .env

# Local preview server port (optional)
PORT=4321

# Where the browser sends booking requests during local dev.
# server.js serves this via /config.js so script.js picks it up automatically.
BOOKING_ENDPOINT=/booking

# Telegram — local dev only. On production these live in Netlify env vars
# (or wrangler secret put BOT_TOKEN / CHAT_ID), never in the static files.
BOT_TOKEN=
# Numeric id from @userinfobot (DM), or group id like -1001234567890 (bot must be in the group).
CHAT_ID=

# Public https origin of the deployed site. Used by scripts/set-telegram-webhook.js
# so Confirm / Decline taps reach this project.
# SITE_URL=https://your-site.netlify.app

# Optional. If omitted, a value is derived from BOT_TOKEN. Set the same
# TELEGRAM_WEBHOOK_SECRET in Netlify if you set it here.
# TELEGRAM_WEBHOOK_SECRET=

# Local only: TELEGRAM_POLL=1 deletes the production webhook and handles
# button taps on this machine. Re-run scripts/set-telegram-webhook.js after.
# TELEGRAM_POLL=1

# Client emails after confirm / reject. One provider is enough.
#
# Free, no domain: send from the Gmail you created (App Password, not the
# normal Gmail password). Google Account → Security → 2-Step Verification →
# App passwords.
#   MAIL_FROM=Pana Carlosa <you@gmail.com>
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=xxxx xxxx xxxx xxxx
#
# Own domain? Resend works too (not with *.netlify.app):
#   MAIL_FROM=Pana Carlosa <rezerwacje@your-domain>
#   RESEND_API_KEY=re_...
MAIL_FROM=
MAIL_FROM_NAME=Pana Carlosa
SMTP_USER=
SMTP_PASS=
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=
BREVO_API_KEY=
